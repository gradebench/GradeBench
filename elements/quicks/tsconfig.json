{
	"extends": "../../packages/typescript-config/react-library.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "dist",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@gb-element/quicks/*": ["./src/*"],
			"@gb/*": ["../../packages/*"]
		}
	},
	"exclude": ["node_modules", "dist"]
}
