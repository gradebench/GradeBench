{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"files": {
		"includes": [
			"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,json,jsonc,html,css,yaml,yml,md}",
			"!**/node_modules",
			"!**/.next",
			"!**/dist",
			"!**/build",
			"!**/specs"
		],

		"ignoreUnknown": true
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"linter": {
		"enabled": true,
		"includes": [
			"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,json,jsonc,html,css,yaml,yml,md}"
		],
		"rules": {
			"recommended": true,
			"a11y": {
				"recommended": true
			},
			"complexity": {
				"recommended": true
			},
			"correctness": {
				"recommended": true
			},
			"nursery": {
				"recommended": true,
				"useSortedClasses": "on"
			},
			"performance": {
				"recommended": true
			},
			"security": {
				"recommended": true
			},
			"style": {
				"recommended": true
			},
			"suspicious": {
				"recommended": true,
				"noUnknownAtRules": "off",
				"noArrayIndexKey": "off"
			}
		},
		"domains": {
			"next": "recommended",
			"react": "recommended",
			"test": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"includes": [
			"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,json,jsonc,html,css,yaml,yml,md}"
		],
		"actions": {
			"recommended": true,
			"source": {
				"recommended": true,
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"includes": [
			"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,json,jsonc,html,css,yaml,yml,md}"
		]
	},
	"javascript": {
		"formatter": {
			"enabled": true
		},
		"globals": [],
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		}
	},
	"json": {
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": true
		},
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		}
	},
	"graphql": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		}
	},
	"grit": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		}
	},
	"html": {
		"formatter": {
			"enabled": true
		},
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		}
	}
}
