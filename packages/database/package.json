{
  "name": "@gb/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "db:up": "npx drizzle-kit up",
    "db:studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.44.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@gb/typescript-config": "^1.0.0",
    "@types/node": "^22.16.4",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    },
    "./schema": {
      "import": {
        "default": "./dist/db/schema.js",
        "types": "./dist/db/schema.d.ts"
      },
      "require": {
        "default": "./dist/db/schema.cjs",
        "types": "./dist/db/schema.d.ts"
      }
    }
  }
}
