{
	"extends": ["@gb/typescript-config/nextjs.json"],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@gb-kits/*": ["../../kits/*"],
			"@gb-element/*": ["../../elements/*"],
			"@gb/*": ["../../packages/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	]
}
